REGION=us-east-1
EKS_CLUSTER_NAME=genai-on-eks
EKS_MODE=auto
DOMAIN=
HF_TOKEN=
# LiteLLM
LITELLM_UI_USERNAME=litellm-admin
LITELLM_UI_PASSWORD=your-strong-password-here
LITELLM_API_KEY=sk-your-api-key-here
# Kong
KONG_API_KEY=sk-your-kong-key-here
KONG_API_KEY_HEADER=apikey
# Langfuse
LANGFUSE_USERNAME=admin@example.com
LANGFUSE_PASSWORD=your-strong-password-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# MLflow
MLFLOW_USERNAME=admin
MLFLOW_PASSWORD=your-strong-password-here
# Phoenix
PHOENIX_API_KEY=
# qDrant
QDRANT_USERNAME=admin
QDRANT_PASSWORD=your-strong-password-here
# Milvus
MILVUS_USERNAME=admin
MILVUS_PASSWORD=your-strong-password-here
# Guardrails AI
GUARDRAILS_AI_API_KEY=

# Per-app LiteLLM virtual keys. Apps must NOT use LITELLM_API_KEY (the gateway
# master key) - that one can mint keys and read every tenant's spend, and belongs
# only to the litellm component itself. Mint one per app after the gateway is up:
#   curl $GATEWAY/key/generate -H "Authorization: Bearer $LITELLM_API_KEY" \
#     -d '{"key_alias":"openwebui","team_id":"<team>","max_budget":300,"budget_duration":"30d"}'
LITELLM_KEY_OPENWEBUI=
LITELLM_KEY_STRANDS_AGENT=
LITELLM_KEY_OPENCLAW=
LITELLM_KEY_AGNO_AGENT=
